# Copy to .env on the production server; never commit the real file.
# These two values MUST identify the same public hostname.
ORRERY_DOMAIN=your-domain.com
PUBLIC_APP_URL=https://your-domain.com
API_BASE_URL=/api
ACME_EMAIL=operator@your-domain.com
GIT_COMMIT=unknown
# Local development needs none of these variables. /app is the simulator.
