{
 email {$ACME_EMAIL}
 admin off
 log default {
  format filter {
   wrap json
   fields {
    request delete
   }
  }
 }
 servers {
  timeouts {
   read_header 10s
   read_body 60s
   idle 60s
  }
 }
}
{$ORRERY_DOMAIN} {
 root * /srv
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Cross-Origin-Opener-Policy same-origin
  Cross-Origin-Embedder-Policy require-corp
  Cross-Origin-Resource-Policy same-origin
  Strict-Transport-Security "max-age=31536000"
  -Server
 }
 import /etc/caddy/security.caddy
 request_body {
  max_size 32MB
 }
 @api path /api /api/*
 handle @api {
  header X-Robots-Tag "noindex, nofollow"
  header Cache-Control "no-store"
  reverse_proxy {$API_UPSTREAM:api:8000} {
   header_up -X-Forwarded-For
   header_up X-Forwarded-For {remote_host}
   transport http {
    dial_timeout 5s
    response_header_timeout 35s
   }
  }
 }
 @app path /app /app/
 handle @app {
  header X-Robots-Tag "noindex, nofollow"
  header Cache-Control "no-store"
  rewrite * /app.html
  file_server
 }
 @share path_regexp share ^/s/[A-Za-z0-9_-]{1,80}$
 handle @share {
  header X-Robots-Tag "noindex, nofollow"
  header Cache-Control "no-store"
  rewrite * /app.html
  file_server
 }
 @internal path /app.html /security.caddy /public-pages.json /docs /openapi.json
 handle @internal {
  error 404
 }
 @assets path /assets/*
 handle @assets {
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
 }
 handle {
  try_files {path} {path}/index.html
  file_server {
   disable_canonical_uris
  }
 }
 handle_errors {
  @server expression {err.status_code} >= 500
  handle @server {
   rewrite * /500.html
   file_server
  }
  handle {
   rewrite * /404.html
   file_server
  }
 }
}
